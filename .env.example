MONGODB_URI=mongodb://127.0.0.1:27017/haven
PORT=3001
# The frontend or a reverse proxy accesses the API through localhost.
HOST=127.0.0.1
# For password-based warden login, set these before the first startup.
# Existing warden accounts keep their current password on restart.
WARDEN_NAME=Hostel Warden
WARDEN_EMAIL=
WARDEN_PASSWORD=
# Disable the demo login buttons when using real data.
SEED_DEMO=false
# Set this to the full frontend origin when using a reverse proxy.
APP_ORIGIN=
